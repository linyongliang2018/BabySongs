<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/widget_song_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_idle_title"
        android:textColor="#FF15211E"
        android:textSize="26sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_album_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginTop="6dp"
        android:text="@string/widget_idle_subtitle"
        android:textColor="#FF4D6360"
        android:textSize="15sp"
        android:fontFamily="sans-serif" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/widget_side_btn_bg"
            android:contentDescription="@string/cd_skip_previous"
            android:padding="14dp"
            android:src="@drawable/ic_widget_prev" />

        <ImageButton
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/widget_play_bg"
            android:contentDescription="@string/cd_play_pause"
            android:padding="16dp"
            android:src="@drawable/ic_widget_play" />

        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/widget_side_btn_bg"
            android:contentDescription="@string/cd_skip_next"
            android:padding="14dp"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>

</LinearLayout>
